{
  "name": "pinpoint-feedback-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/react",
    "packages/nextjs",
    "packages/pinpoint-feedback",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @pinpoint-feedback/core && npm run build -w @pinpoint-feedback/server && npm run build -w @pinpoint-feedback/react && npm run build -w @pinpoint-feedback/nextjs && npm run build -w pinpoint-feedback",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
