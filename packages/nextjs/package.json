{
  "name": "@pinpoint-feedback/nextjs",
  "version": "0.1.0",
  "description": "Next.js App Router integration for Pinpoint Feedback.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@pinpoint-feedback/core": "0.1.0",
    "@pinpoint-feedback/react": "0.1.0",
    "@pinpoint-feedback/server": "0.1.0",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": ">=14.2.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  }
}
