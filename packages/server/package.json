{
  "name": "@pinpoint-feedback/server",
  "version": "0.1.1",
  "description": "Framework-independent server handler and Notion backend for Pinpoint Feedback (Web Request/Response).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwrth/pinpoint-feedback.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/dwrth/pinpoint-feedback#readme",
  "bugs": {
    "url": "https://github.com/dwrth/pinpoint-feedback/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@notionhq/client": "^5.31.1",
    "@pinpoint-feedback/core": "0.1.1"
  }
}
