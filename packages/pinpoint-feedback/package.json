{
  "name": "pinpoint-feedback",
  "version": "0.1.0",
  "description": "Visual website feedback widget with screenshot annotation. Reports go straight into your Notion database.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": ["feedback", "bug-report", "screenshot", "annotation", "notion", "nextjs", "react", "widget"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./nextjs": { "types": "./dist/nextjs.d.ts", "import": "./dist/nextjs.js" },
    "./nextjs/server": { "types": "./dist/nextjs-server.d.ts", "import": "./dist/nextjs-server.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@pinpoint-feedback/core": "0.1.0",
    "@pinpoint-feedback/nextjs": "0.1.0",
    "@pinpoint-feedback/react": "0.1.0",
    "@pinpoint-feedback/server": "0.1.0"
  },
  "peerDependencies": {
    "next": ">=14.2.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  }
}
